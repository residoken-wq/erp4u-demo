# =================================================================
# ERP4U - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =================================================================

# --- Production Deployment (VPS) ---
# KHÔNG ĐẶT biến APP_TAG ở đây: ./scripts/deploy.sh sẽ tự truyền APP_TAG qua môi trường lệnh
# APP_TAG=latest

# --- Database Configuration (PostgreSQL) ---
# LƯU Ý QUAN TRỌNG TRÊN VPS:
# Service postgres (docker-compose.prod.yml) sử dụng POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB.
# Backend DB_* (DB_USERNAME, DB_PASSWORD, DB_DATABASE) phải khớp chính xác với POSTGRES_*.
# Trong docker-compose.prod.yml, backend đã được ánh xạ tự động từ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
POSTGRES_USER=erp4u_user
# [BẮT BUỘC TRÊN VPS] Đổi thành mật khẩu bảo mật ngẫu nhiên
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=erp4u_db

# Khi chạy local dev ngoài docker compose:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp4u_user
DB_PASSWORD=change-me-postgres-password
DB_DATABASE=erp4u_db

# Tự động chạy TypeORM migrations khi backend khởi động (mặc định: true).
# Đặt false nếu muốn tự chạy tay qua image tools (npm run migration:run) trước khi bật backend.
DB_AUTO_MIGRATE=true

# --- Security & Authentication ---
# [BẮT BUỘC Ở PRODUCTION] bắt buộc ở production, ≥32 ký tự, tạo bằng `openssl rand -hex 32`
JWT_SECRET=change-me-jwt-secret-min-32-chars-random-string

# [BẮT BUỘC Ở PRODUCTION] AES-256-GCM Encryption Key for PII (Customer phone, email, tax code, employee info)
# bắt buộc ở production, ≥32 ký tự, tạo bằng `openssl rand -hex 32`
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Demo Mode ---
# [BẮT BUỘC TRÊN VPS DEMO] Bật true để chặn gọi webhook/email/SMS/ZNS thật ra ngoài và bảo vệ tài khoản demo
DEMO_MODE=true

# --- RBAC Enforcement & Emergency Switch (P12a) ---
# Biến môi trường ghi đè chế độ phân quyền RBAC cho mọi tenant:
# - SHADOW: Ghi log truy cập vi phạm, không chặn request (an toàn khi khảo sát / khẩn cấp quay xe)
# - ENFORCE: Chặn thật các request thiếu quyền (403) hoặc chưa đăng nhập (401)
# Bỏ trống hoặc không đặt để sử dụng cấu hình chế độ trong DB của từng tenant.
# RBAC_FORCE_MODE=SHADOW

# --- Modular Package Entitlements (P6) ---
# Chế độ kiểm tra bản quyền tính năng theo gói:
# - all: Bật tất cả tính năng (dành cho môi trường Demo và Self-host)
# - db: Đọc cấu hình gói kích hoạt của tenant từ cơ sở dữ liệu (bảng tenant_entitlement)
# Mặc định: all
ENTITLEMENTS_MODE=all

# --- Multi-Tenancy (P7) ---
# Chế độ nghiêm ngặt cho TenantContext (AsyncLocalStorage):
# - false (mặc định, Self-host / Single-tenant): khi không có ngữ cảnh tenant sẽ dùng default/public
# - true (bản SaaS Multi-tenant): ném lỗi nếu truy cập TenantContext ngoài TenantContext.run(...)
TENANCY_STRICT=false

# Tự động chạy seed dữ liệu mặc định theo tenant khi khởi động:
# - true (mặc định): chạy mọi TenantSeeder cho toàn bộ tenant đăng ký (Single-tenant giữ nguyên)
# - false: bỏ qua chạy seed lúc boot (dùng cho SaaS cloud quản lý seed qua luồng provisioning riêng)
SEED_ON_BOOT=true

# --- Application Server ---
PORT=3000
NODE_ENV=production

# --- Rate Limiting (P7c6a) ---
# Cơ chế giới hạn số lần thử (in-process memory store).
# Multi-instance / Cloud có thể thay thế bằng Redis qua RateLimitStore interface.
# DEMO_MODE không được tắt các giới hạn này.
# Đăng nhập: giới hạn theo IP+username (chỉ đếm lần sai) và IP
RATE_LIMIT_LOGIN_USER_MAX=10
RATE_LIMIT_LOGIN_USER_WINDOW_SEC=900
RATE_LIMIT_LOGIN_IP_MAX=50
RATE_LIMIT_LOGIN_IP_WINDOW_SEC=900
# Portal khách: request-otp và verify-otp
RATE_LIMIT_PORTAL_OTP_IDENTIFIER_MAX=5
RATE_LIMIT_PORTAL_OTP_IDENTIFIER_WINDOW_SEC=900
RATE_LIMIT_PORTAL_OTP_IP_MAX=20
RATE_LIMIT_PORTAL_OTP_IP_WINDOW_SEC=900
RATE_LIMIT_PORTAL_OTP_VERIFY_MAX=5
# Portal ứng viên & nộp hồ sơ
RATE_LIMIT_RECRUITMENT_IP_MAX=20
RATE_LIMIT_RECRUITMENT_IP_WINDOW_SEC=900

# Comma-separated list of allowed origins for CORS
# Dùng cho SaaS (hỗ trợ wildcard một cấp subdomain):
# CORS_ORIGINS=https://erp4u.conix.cloud,https://*.erp4u.conix.cloud
# Trên VPS demo, trỏ domain chính thức:
CORS_ORIGINS=https://erp4u-demo.conix.cloud

# --- Public URL & Frontend ---
# URL public của ứng dụng phục vụ tạo link trong email, portal khách hàng / nhà cung cấp
PUBLIC_APP_URL=https://erp4u-demo.conix.cloud
VITE_API_URL=/api
