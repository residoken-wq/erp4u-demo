# =================================================================
# ERP4U - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =================================================================

# --- Database Configuration (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp4u_user
DB_PASSWORD=erp4u_password
DB_DATABASE=erp4u_db

# --- Security & Authentication ---
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# AES-256-GCM Encryption Key for PII (Customer phone, email, tax code, employee info)
# Must be a 32-byte hex string (64 characters) or 32+ character string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Application Server ---
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080

# --- Frontend (Vite) ---
# Used by frontend build/runtime to connect to API
VITE_API_URL=http://localhost:3000/api
